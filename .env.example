# 64 hex chars = 32 bytes. Generate: node bin/otp-cli.js gen-key
OTP_MASTER_KEY=
# Any long random string (>= 32 chars). Generate: node bin/otp-cli.js gen-key
OTP_PEPPER=
# API key clients must send in the x-api-key header
OTP_API_KEY=
PORT=8080
OTP_AUDIT_FILE=./data/audit.jsonl
OTP_STORE_FILE=./data/store.json

# ---- optional hardening (see docs/15-advanced-hardening.md) ----
# HMAC-signed requests instead of OTP_API_KEY: "id:64+hex chars", comma separated. Generate a secret: openssl rand -hex 32
# OTP_HMAC_KEYS=backend-1:0123...abcd
# OTP_ALLOWED_CIDRS=10.0.0.0/8,127.0.0.1
# OTP_TRUSTED_PROXIES=10.0.0.0/8
# OTP_MIN_VERIFY_MS=150
# OTP_UNIFORM_ERRORS=strict        # true (default) | strict | off
# OTP_METRICS=1
# OTP_WEBAUTHN_RP_ID=example.com
# OTP_WEBAUTHN_ORIGINS=https://example.com

# ---- storage (production requires one of these; default dev store is in-memory) ----
# OTP_SQLITE_FILE=./data/otp.db         # single host, durable, Node >= 22.5
# OTP_DATABASE_URL=postgres://user:pass@host:5432/otp   # multi-node; run `npm install pg` first
# OTP_STORE_FILE=./data/store.json      # demo only
# OTP_ALLOW_MEMORY_STORE=1              # accept data loss on restart (not for production)

# ---- WebAuthn attestation policy (docs/19-webauthn-attestation.md) ----
# OTP_WEBAUTHN_ATTESTATION_FORMATS=none            # none | packed | fido-u2f, comma separated
# OTP_WEBAUTHN_TRUST_ANCHORS_FILE=./vendor-roots.pem
# OTP_WEBAUTHN_REQUIRE_TRUSTED=1                   # reject attestation that does not chain to the anchors
# OTP_WEBAUTHN_AAGUID_ALLOWLIST=ee882879-721c-4913-9775-3dfcce97072a   # implies REQUIRE_TRUSTED
# OTP_WEBAUTHN_AAGUID_DENYLIST=
# OTP_WEBAUTHN_ALLOW_SELF=1                        # accept packed self-attestation (never counts as trusted)
