{
  "name": "0tp-f0rtr3ss-9k27",
  "version": "2.2.1",
  "description": "Dependency-free Node.js toolkit for one-time passwords and related authentication: HOTP/TOTP, email and SMS codes, backup codes, WebAuthn passkeys, an HTTP API, and the rate limiting, lockout and audit pieces around them.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "otp-fortress": "bin/otp-cli.js",
    "otp-fortress-audit": "bin/audit-tool.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "start": "node bin/server.js",
    "cli": "node bin/otp-cli.js",
    "example:totp": "node examples/01-totp-basic.js",
    "example:email": "node examples/02-email-otp.js",
    "example:backup": "node examples/03-backup-codes.js",
    "example:txn": "node examples/04-transaction-otp.js",
    "example:push": "node examples/05-push-number-matching.js",
    "check": "node scripts/verify-repo.js",
    "bench": "node scripts/bench.js",
    "vectors": "node scripts/gen-vectors.js",
    "test:python": "cd ports/python && python3 -m unittest -v",
    "example:qr": "node examples/07-qr-login.js",
    "example:trust": "node examples/08-device-trust.js",
    "example:rotate": "node examples/09-key-rotation.js",
    "example:entropy": "node examples/10-entropy-calculator.js",
    "example:failover": "node examples/11-failover-delivery.js",
    "audit": "node bin/audit-tool.js",
    "fuzz": "FUZZ_SEED=$RANDOM node --test tests/fuzz.test.js",
    "example:webauthn": "node examples/12-webauthn-simulated.js",
    "example:shamir": "node examples/13-shamir-master-key.js",
    "example:signed": "node examples/14-signed-requests.js",
    "example:export": "node examples/15-encrypted-export.js",
    "mutation": "node scripts/mutation-check.js",
    "test:stores": "node --test tests/stores.test.js",
    "cross-check": "node scripts/cross-check.js",
    "test:java": "java ports/java/OtpFortress.java selftest",
    "test:go": "cd ports/go && go vet ./... && go test ./...",
    "example:attestation": "node examples/16-attestation-policy.js"
  },
  "keywords": [
    "otp",
    "totp",
    "hotp",
    "2fa",
    "mfa",
    "authentication",
    "security",
    "rfc4226",
    "rfc6238",
    "open-source",
    "learning",
    "qr-login",
    "passkeys-alternative",
    "sqlite",
    "key-rotation",
    "rate-limiting",
    "webauthn",
    "passkeys",
    "fido2",
    "shamir",
    "hmac-signing",
    "fuzzing",
    "audit-log",
    "postgres",
    "attestation",
    "fido2",
    "cross-language",
    "conformance-tests",
    "postgres",
    "attestation",
    "fido",
    "golang",
    "java",
    "cross-language"
  ],
  "license": "MIT"
}
